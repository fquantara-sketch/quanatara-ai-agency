# Nakili file hili kama .env kisha weka values zako halisi.
# File la .env linaingia .gitignore, kwa hivyo halitaingia GitHub.

# URL ya edge function yetu ya chat (baada ya ku-deploy).
# Mfano: https://abcdefgh.supabase.co/functions/v1/chat
EXPO_PUBLIC_CHAT_API_URL=https://your-project-ref.supabase.co/functions/v1/chat

# Supabase anon key (public key — ni salama kuwa kwenye app).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# KUMBUKA: DEEPSEEK_API_KEY HAIWEKI HAPA.
# Key hiyo inawekwa kwenye Supabase secrets (server), si kwenye app:
#   supabase secrets set DEEPSEEK_API_KEY=sk-xxxxx
